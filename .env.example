# Copy this file to .env and fill in your values. Never commit .env.

# Required: Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: Gemini model name (default: gemini-3.8-flash)
GEMINI_MODEL=

# Optional: SQLite file location, relative to the project root (default: data/querypilot.db)
QUERYPILOT_DB_PATH=

# Optional: agent limits (defaults shown)
QUERYPILOT_MAX_RETRIES=2
QUERYPILOT_MAX_ROWS=200
QUERYPILOT_QUERY_TIMEOUT_SECONDS=5

# Optional: uploaded SQLite databases (defaults shown; upload limit is capped at 200)
QUERYPILOT_UPLOAD_DIR=data/uploads
QUERYPILOT_MAX_UPLOAD_MB=50

# Optional: seconds between live integration tests (free-tier rate limits)
QUERYPILOT_INTEGRATION_DELAY=30
